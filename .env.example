# Скопируйте в .env и заполните своими значениями.
# .env в .gitignore — реальные секреты в репозиторий не попадают.

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM: ollama (локальная модель) | openai (внешний API)
LLM_PROVIDER=ollama

# Локальная модель (Ollama, native API)
# ВАЖНО: 127.0.0.1, а не localhost (Ollama слушает только IPv4)
#
# OLLAMA_URL допускает СПИСОК через запятую — резервные адреса (failover).
# Пример для продакшена: бот на VPS, а Ollama у ребят дома в сети Tailscale:
#   OLLAMA_URL=http://127.0.0.1:11434,http://100.101.102.103:11434
# Второй адрес подхватится, только если первый не ответил.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Сколько держать модель в памяти между запросами (быстрый старт следующего фото)
OLLAMA_KEEP_ALIVE=30m

# Внешний OpenAI-совместимый API (используется при LLM_PROVIDER=openai)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Прочее
LLM_TIMEOUT_MS=180000
# Ретраи на каждый адрес Ollama (0 = без повторов)
LLM_RETRIES=3
# Пауза перед повтором, мс (растёт: delay, 2×, 3×…)
LLM_RETRY_DELAY_MS=1000
# Общий лимит времени на все попытки и адреса, мс
LLM_TOTAL_BUDGET_MS=180000
# Если все адреса Ollama недоступны — уйти на OpenAI (нужен OPENAI_API_KEY).
# По умолчанию false: фото не покидает приватный контур.
LLM_FALLBACK_TO_OPENAI=false
# Проверять доступность Ollama при старте (пишет в лог, бота не роняет)
LLM_HEALTHCHECK=true
LLM_HEALTHCHECK_TIMEOUT_MS=5000
ORDER_STATUS=Новая Заявка
# Старые фото шильдиков (читаются в разделе «Медиафайлы», новые файлы сюда не пишутся)
PHOTO_DIR=bot/storage/photos
# Медиафайлы (фото/видео из бота и с сайта). На VPS укажите путь на постоянном диске.
MEDIA_DIR=bot/storage/media
WHITELIST_FILE=whitelist.json
